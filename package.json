{
  "name": "colored-noise",
  "version": "1.0.0",
  "description": "A free, browser-based noise generator with advanced multi-voice polyrhythm capabilities",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "start": "npx serve .",
    "build": "bash scripts/build-dist.sh",
    "deploy": "bash scripts/build-dist.sh && wrangler pages deploy dist --project-name=colorednoise --branch=main",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "serve": "^14.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.130.0"
  },
  "keywords": [
    "noise-generator",
    "white-noise",
    "pink-noise",
    "brown-noise",
    "web-audio",
    "sleep",
    "focus",
    "ambient"
  ],
  "author": "Gabriel Berger",
  "license": "MIT"
}
